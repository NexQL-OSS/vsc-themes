---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Editor from "../components/Editor.astro";
import InstallSteps from "../components/InstallSteps.astro";
import {
  DEFAULT_THEME,
  FAMILIES,
  PAIRS,
  SYNTAX_ROLES,
  THEMES,
  THEME_COUNT,
  clientTheme,
  previewStyle,
  themeHref,
  type Theme,
} from "../data/themes";
import { MARKETPLACE_URL, MCP_URL, NEXQL_URL, OPEN_VSX_URL, REPO_URL } from "../data/site";

const STOPS = [
  { id: "gallery", label: "Gallery", minutes: `${THEME_COUNT} themes` },
  { id: "families", label: "Families", minutes: `${PAIRS.length} pairs` },
  { id: "syntax", label: "Syntax", minutes: "8 colours" },
  { id: "install", label: "Install", minutes: "1 minute" },
];
const pad = (n: number) => String(n).padStart(2, "0");
const stopNo = (id: string) => pad(STOPS.findIndex((s) => s.id === id) + 1);
const nextOf = (id: string) => STOPS[STOPS.findIndex((s) => s.id === id) + 1];
const words = (t: Theme) => `${t.family} ${t.name}`.toLowerCase();
const dflt = DEFAULT_THEME;
const darkCount = THEMES.filter((t) => !t.light).length;
const SUGGESTIONS = [
  "WHERE type = 'dark'",
  "WHERE type = 'light'",
  "WHERE family = 'Claudy'",
  "WHERE family = 'Sentinel'",
  "WHERE family = 'Seasonal'",
  "WHERE name LIKE 'Postgres%'",
];

const description = `${THEME_COUNT} color themes for VS Code in one extension, from warm clay days to pure-black OLED nights. Keywords, functions, tables and columns each get their own colour. Preview any theme in your browser, then install.`;
---

<BaseLayout title={`NexQL Themes: ${THEME_COUNT} VS Code color themes for SQL`} description={description}>
  <SiteHeader />

  <main id="main" tabindex="-1">
    <!-- Start -->
    <section class="hero wrap" id="top">
      <div class="hero-copy">
        <p class="pill"><span class="live-dot" aria-hidden="true"></span>{THEME_COUNT} themes · {FAMILIES.length} families · one extension</p>
        <h1>
          {THEME_COUNT} VS Code themes that make SQL <span class="serif-em grad-text">readable</span>.
        </h1>
        <p class="lede">
          NexQL Themes is a single extension with {darkCount} dark and {THEME_COUNT - darkCount} light themes. Keywords, functions, tables and columns each get their
          own colour, and the text pairs are checked for contrast. Pick a theme in the preview to see it before you install.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={MARKETPLACE_URL}>Install from Marketplace</a>
          <a class="btn" href="#gallery">Browse the gallery</a>
        </div>
        <p class="also">Also on <a href={OPEN_VSX_URL}>Open VSX</a>. Made to sit next to <a href={NEXQL_URL}>NexQL for VS Code</a> and <a href={MCP_URL}>NexQL MCP</a>.</p>
      </div>

      <aside class="ticket" id="preview" aria-label="Preview a theme">
        <div class="ticket-head">
          <span class="mono-label">Preview a theme</span>
          <span class="mono-label" aria-live="polite" data-theme-kind>{dflt.light ? "Light" : "Dark"} · {dflt.family}</span>
        </div>

        <div class="picker" data-picker hidden>
          <button type="button" class="step" data-step="-1" aria-label="Previous theme">‹</button>
          <label class="sr" for="pick">Theme</label>
          <select id="pick" data-pick>
            {
              FAMILIES.map((f) => (
                <optgroup label={f.name}>
                  {f.themes.map((t) => (
                    <option value={t.id} selected={t.id === dflt.id}>{t.short}</option>
                  ))}
                </optgroup>
              ))
            }
          </select>
          <button type="button" class="step" data-step="1" aria-label="Next theme">›</button>
          <button type="button" class="tour-btn" data-tour aria-pressed="false" title="Step through the themes automatically">
            <span class="tour-dot" aria-hidden="true"></span>Tour: <span data-tour-label>off</span>
          </button>
        </div>

        <div data-live-scope style={previewStyle(dflt)}>
          <Editor theme={dflt} live />
        </div>

        <div class="swatches" role="radiogroup" aria-label="Themes" data-swatches hidden>
          {
            THEMES.map((t) => (
              <button
                type="button"
                role="radio"
                aria-checked={t.id === dflt.id ? "true" : "false"}
                tabindex={t.id === dflt.id ? 0 : -1}
                data-id={t.id}
                aria-label={t.name}
                title={t.short}
                style={`--s-bg:${t.bg};--s-accent:${t.accent};--s-edge:${t.border}`}
              >
                <i />
              </button>
            ))
          }
        </div>

        <div class="ticket-foot">
          <label class="repaint" data-repaint-wrap hidden>
            <input type="checkbox" data-repaint />
            <span>Repaint this page</span>
          </label>
          <a href={themeHref(dflt)} data-theme-link>Open <span data-theme-short>{dflt.short}</span> →</a>
        </div>
      </aside>
    </section>

    <!-- Mobile progress, under the header -->
    <div class="mbar">
      <div class="mbar-fill"></div>
      <span class="mbar-label">Stop 01 of {pad(STOPS.length)} · {STOPS[0].label}</span>
    </div>

    <div class="tour wrap">
      <nav class="rail" aria-label="Page sections">
        <div class="track"><div class="track-fill"></div></div>
        <ol>
          {
            STOPS.map((s, i) => (
              <li>
                <a href={`#${s.id}`} data-stop={s.id}>
                  <span class="dot" />
                  <span class="rail-text">
                    <span class="rail-no">Stop {pad(i + 1)}</span>
                    <span class="rail-label">{s.label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="rail-app">Previewing <b data-theme-short>{dflt.short}</b> · <a href="#preview">change</a></p>
      </nav>

      <div class="stops">
        <!-- 01 Gallery -->
        <section class="stop" id="gallery">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("gallery")}</b></span>
            <span class="stop-time">{STOPS[0].minutes}</span>
          </header>
          <h2>Every theme in its own <span class="serif-em">colours</span>.</h2>
          <p class="lede">
            Each window below is drawn with that theme's real editor colours, grouped by family. Open a theme for its full palette, or send it to the preview at the top.
          </p>

          <div class="filter">
            <label class="prompt" for="q">nexql=#</label>
            <input id="q" type="text" list="q-list" placeholder="WHERE type = 'dark'" spellcheck="false" autocomplete="off" aria-describedby="q-count" />
            <datalist id="q-list">{SUGGESTIONS.map((s) => <option value={s} />)}</datalist>
            <span class="count" id="q-count" aria-live="polite">→ <b data-count>{THEME_COUNT}</b> of {THEME_COUNT}</span>
            <button type="button" class="clear" data-clear hidden>Clear</button>
          </div>

          <div class="families">
            {
              FAMILIES.map((f) => (
                <section class="family" data-family aria-labelledby={`f-${f.name.replace(/\W+/g, "-").toLowerCase()}`}>
                  <header class="family-head">
                    <h3 id={`f-${f.name.replace(/\W+/g, "-").toLowerCase()}`}>{f.name}</h3>
                    <span class="family-n">{f.themes.length}</span>
                    <p>{f.note}</p>
                  </header>
                  <div class="cards">
                    {f.themes.map((t) => (
                      <article class="card" data-card data-words={words(t)} data-kind={t.light ? "light" : "dark"}>
                        <Editor theme={t} variant="mini" />
                        <div class="meta">
                          <span class="dot-accent" style={`background:${t.accent}`} aria-hidden="true" />
                          <a class="name" href={themeHref(t)}>{t.short}</a>
                          <span class="kind">{t.light ? "Light" : "Dark"}</span>
                        </div>
                        <button type="button" class="try" data-try={t.id}>Preview</button>
                      </article>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>
          <p class="empty" data-empty hidden>0 rows returned. Try <code>WHERE type = 'light'</code>.</p>

          <a class="next" href={`#${nextOf("gallery").id}`}>Next stop <b>{nextOf("gallery").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 02 Families -->
        <section class="stop" id="families">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("families")}</b></span>
            <span class="stop-time">{STOPS[1].minutes}</span>
          </header>
          <h2>Day shift, <span class="serif-em">night</span> shift.</h2>
          <p class="lede">
            {PAIRS.length} families ship a matched light and dark pair with the same hues, so your editor looks the same at stand-up and at midnight. VS Code can switch between them on its own.
          </p>

          <div class="pairs">
            {
              PAIRS.map((p) => (
                <div class="pair">
                  <h3>{p.family}</h3>
                  <div class="panes">
                    {[p.day, p.night].map((t) => (
                      <div class="pane">
                        <Editor theme={t} variant="mini" />
                        <div class="meta">
                          <span class="kind">{t.light ? "Light" : "Dark"}</span>
                          <a class="name" href={themeHref(t)}>{t.short}</a>
                          <button type="button" class="try" data-try={t.id}>Preview</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <h3 class="sub">Follow the system</h3>
          <p class="small">To switch with your operating system, turn on automatic detection and name a theme for each side:</p>
          <figure class="code">
            <pre><span class="c">// settings.json</span>
"window.autoDetectColorScheme": true,
"workbench.preferredLightColorTheme": "NexQL Claudy Day",
"workbench.preferredDarkColorTheme": "NexQL Claudy Night"</pre>
            <button class="copy" type="button" aria-label="Copy settings">Copy</button>
          </figure>

          <a class="next" href={`#${nextOf("families").id}`}>Next stop <b>{nextOf("families").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 03 Syntax -->
        <section class="stop" id="syntax">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("syntax")}</b></span>
            <span class="stop-time">{STOPS[2].minutes}</span>
          </header>
          <h2>Each part of a query gets its own <span class="serif-em">voice</span>.</h2>
          <p class="lede">
            Keywords, functions, types, strings and numbers are told apart at a glance, so a long query stays readable. This is <b data-theme-short>{dflt.short}</b>; change the preview at the top and it follows.
          </p>

          <div class="syntax" data-live-scope style={previewStyle(dflt)}>
            <Editor theme={dflt} live />
            <ul class="legend">
              {
                SYNTAX_ROLES.map((r) => (
                  <li>
                    <span class="sw" style={`background:var(--p-${r.key})`} aria-hidden="true" />
                    <span class="role">{r.label}</span>
                    <code class="hex" data-hex={r.key}>{dflt[r.key].toUpperCase()}</code>
                  </li>
                ))
              }
            </ul>
          </div>

          <a class="next" href={`#${nextOf("syntax").id}`}>Next stop <b>{nextOf("syntax").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 04 Install -->
        <section class="stop" id="install">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("install")}</b></span>
            <span class="stop-time">{STOPS[3].minutes}</span>
          </header>
          <h2>Install once, then pick <span class="serif-em">any</span> of them.</h2>
          <p class="lede">All {THEME_COUNT} themes come in the same extension, so there is nothing else to download.</p>

          <InstallSteps theme={dflt} live />

          <div class="hero-cta">
            <a class="btn btn-primary" href={MARKETPLACE_URL}>Install from Marketplace</a>
            <a class="btn" href="vscode:extension/ric-v.nexql-themes">Open in VS Code</a>
            <a class="btn btn-ghost" href={OPEN_VSX_URL}>Open VSX</a>
          </div>

          <a class="next" href="#arrived">Final stop <b>You're set</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- Arrived -->
        <section class="arrived" id="arrived">
          <div class="ribbon"></div>
          <h2>You're <span class="serif-em grad-text">set</span>.</h2>
          <p class="lede">That's every theme and the install. A few answers, in case something looks off.</p>
          <div class="faq">
            <details>
              <summary>How do I go back to my old theme?</summary>
              <p>Run <b>Preferences: Color Theme</b> from the Command Palette and choose it. Uninstalling the extension also removes all {THEME_COUNT} themes.</p>
            </details>
            <details>
              <summary>Do the themes change my settings?</summary>
              <p>No. The extension only adds colour themes. Nothing changes until you pick one, and your own <code>settings.json</code> stays as it is.</p>
            </details>
            <details>
              <summary>Can I tweak a colour?</summary>
              <p>Yes. Use <code>workbench.colorCustomizations</code> and <code>editor.tokenColorCustomizations</code> in <code>settings.json</code>; they override any theme. The theme pages list every hex value to start from.</p>
            </details>
            <details>
              <summary>Why does the page change colour when I preview a theme?</summary>
              <p>Only if you tick <b>Repaint this page</b> in the preview. Otherwise this site keeps its own palette and only the preview windows change.</p>
            </details>
          </div>
          <div class="hero-cta">
            <a class="btn btn-primary" href={MARKETPLACE_URL}>Install from Marketplace</a>
            <a class="btn" href={NEXQL_URL}>NexQL for VS Code</a>
            <a class="btn btn-ghost" href={`${REPO_URL}/issues`}>Report a problem</a>
          </div>
        </section>
      </div>
    </div>

    <div class="previewing" data-chip hidden>
      <span>Previewing <b data-theme-short>{dflt.short}</b></span>
      <button type="button" data-reset>Reset</button>
    </div>
  </main>

  <SiteFooter />
  <script type="application/json" id="theme-data" set:html={JSON.stringify(THEMES.map(clientTheme))} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
    align-items: center;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -48px -8% -20px;
    background-image: var(--dot-grid);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 22% 35%, #000 0%, transparent 68%);
    -webkit-mask-image: radial-gradient(ellipse at 22% 35%, #000 0%, transparent 68%);
    pointer-events: none;
  }
  .hero > * {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr 1.05fr;
      padding-top: 80px;
      padding-bottom: 96px;
      gap: 56px;
    }
  }
  .hero h1 {
    font-size: clamp(36px, 5.4vw, 62px);
    font-weight: 700;
    margin: 22px 0 20px;
    letter-spacing: -0.02em;
  }
  .hero h1 .serif-em {
    font-size: 1.08em;
    padding-right: 0.06em;
  }
  .hero .lede {
    font-size: clamp(17px, 1.6vw, 19px);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .also {
    margin-top: 20px;
    color: var(--faint);
    font-size: 14.5px;
  }

  /* Ticket: the live preview, as a boarding pass */
  .ticket {
    position: relative;
    background: var(--ticket-bg);
    border: 1px solid var(--edge);
    border-radius: 18px;
    padding: 20px 20px 16px;
    box-shadow: var(--shadow-ticket);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }
  .ticket::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 18px;
    padding: 1px;
    background: var(--nex-grad);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: var(--ticket-edge);
    pointer-events: none;
  }
  .ticket-head,
  .ticket-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ticket-foot {
    border-top: 1px dashed var(--line-2);
    padding-top: 12px;
    font-size: 14.5px;
  }
  .picker {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .picker[hidden],
  .swatches[hidden],
  .repaint[hidden],
  [data-chip][hidden] {
    display: none;
  }
  .picker select {
    flex: 1 1 160px;
    min-width: 0;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: var(--well);
    box-shadow: var(--well-shadow);
    color: var(--fg);
  }
  .step,
  .tour-btn,
  .try,
  .clear,
  [data-reset] {
    appearance: none;
    border: 1px solid;
    border-color: var(--bevel-border);
    background: var(--control-bg);
    box-shadow: var(--control-shadow);
    color: var(--fg);
    font: 500 13px/1 var(--font-mono);
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s;
  }
  .step:hover,
  .tour-btn:hover,
  .try:hover,
  .clear:hover,
  [data-reset]:hover {
    background: var(--control-bg-hover);
    box-shadow: var(--control-shadow-hover);
  }
  .step:active,
  .tour-btn:active,
  .try:active,
  .clear:active,
  [data-reset]:active,
  .tour-btn[aria-pressed="true"] {
    box-shadow: var(--control-shadow-active);
  }
  .step {
    width: 44px;
    height: 44px;
    font-size: 20px;
  }
  .tour-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
  }
  .tour-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--faint);
  }
  .tour-btn[aria-pressed="true"] .tour-dot {
    background: var(--nex-amber);
    animation: pulse 1.8s ease-in-out infinite;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .swatches {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }
  .swatches button {
    appearance: none;
    flex: none;
    width: 30px;
    height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .swatches i {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: var(--s-bg);
    border: 1px solid var(--line-2);
    position: relative;
    transition: transform 0.15s;
  }
  .swatches i::after {
    content: "";
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--s-accent);
  }
  .swatches button:hover i {
    transform: scale(1.12);
  }
  .swatches button[aria-checked="true"] i {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent);
  }
  .repaint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    cursor: pointer;
  }
  .repaint input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  /* ---------- Mobile progress ---------- */
  .mbar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: color-mix(in srgb, var(--bg-deep) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding: 9px 16px 10px;
    font: 500 12.5px/1.2 var(--font-mono);
    color: var(--muted);
  }
  .mbar-fill {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 0;
    background: var(--nex-grad);
    transition: width 0.2s;
  }
  @media (min-width: 960px) {
    .mbar {
      display: none;
    }
  }

  /* ---------- Layout with the rail ---------- */
  .tour {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 960px) {
    .tour {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 56px;
    }
  }
  .rail {
    display: none;
  }
  @media (min-width: 960px) {
    .rail {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 40px);
      align-self: start;
    }
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .track {
    position: absolute;
    left: 8px;
    top: 14px;
    width: 3px;
    height: calc(var(--rail-h, 300px) - 28px);
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .track-fill {
    width: 100%;
    height: 0;
    background: var(--nex-grad-v);
    background-size: 100% var(--rail-h, 300px);
    transition: height 0.15s linear;
  }
  .rail a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
    color: var(--faint);
    position: relative;
    z-index: 1;
  }
  .rail a:hover {
    text-decoration: none;
    color: var(--fg);
  }
  .dot {
    width: 19px;
    height: 19px;
    flex: none;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--line-2);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .rail a.done .dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  .rail a.active {
    color: var(--fg);
    background: var(--rail-active);
    border-radius: 10px;
  }
  .rail a.active .dot {
    border-color: var(--accent);
    background: var(--bg);
    box-shadow: var(--accent-glow);
  }
  .rail-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .rail-no {
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .rail-label {
    font-size: 14.5px;
