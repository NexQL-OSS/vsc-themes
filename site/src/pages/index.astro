    left: 16px;
    bottom: 16px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--panel);
    box-shadow: var(--shadow-3);
    font-size: 14px;
  }
  .previewing [data-reset] {
    padding: 8px 12px;
    min-height: 34px;
  }
</style>

<script>
  type CT = Record<string, string | boolean> & { id: string; name: string; short: string; family: string; light: boolean };
  const root = document.documentElement;
  root.classList.add("js");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const themes: CT[] = JSON.parse(document.getElementById("theme-data")!.textContent!);
  const byId = new Map(themes.map((t) => [t.id, t]));
  const KEYS = ["bg", "fg", "panel", "deep", "border", "muted", "accent", "badge", "badgeFg", "sel", "lineHi", "keyword", "func", "typ", "string", "number", "comment", "tag", "operator", "variable", "property", "constant", "parameter"];

  // ---- colour helpers (for the opt-in page repaint) ----
  const hex = (c: string) => {
    let h = c.replace("#", "");
    if (h.length === 3) h = h.split("").map((x) => x + x).join("");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
  };
  const toHex = (rgb: number[]) => "#" + rgb.map((v) => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, "0")).join("");
  const lum = (rgb: number[]) => {
    const [r, g, b] = rgb.map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  const ratio = (a: number[], b: number[]) => {
    const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
    return (hi + 0.05) / (lo + 0.05);
  };
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => v + (b[i] - v) * t);
  /** Moves `color` toward `toward` until it reads at 4.5:1 on every surface in `on`. */
  const readable = (color: number[], toward: number[], on: number[][], start = 0, min = 4.5) => {
    for (let t = start; t <= 1.0001; t += 0.04) {
      const c = mix(color, toward, t);
      if (on.every((s) => ratio(c, s) >= min)) return c;
    }
    return toward;
  };

  const PAGE_VARS = [
    "--bg", "--bg-deep", "--panel", "--panel-2", "--line", "--line-2", "--fg", "--prose", "--muted", "--faint", "--accent", "--accent-hover", "--accent-ink",
    "--comment", "--ok", "--selection", "--hover", "--page-bg", "--header-bg", "--header-bg-stuck", "--header-bg-solid", "--code-bg", "--well", "--surface",
    "--surface-raised", "--control-bg", "--control-bg-hover", "--raised", "--figure-bg", "--ticket-bg", "--pill-bg", "--bevel-border", "--edge", "--rail-active",
    "--nex-grad-text", "--hue-accent", "color-scheme",
  ];
  function repaintPage(t: CT) {
    const bg = hex(t.bg as string), fg = hex(t.fg as string), panel = hex(t.panel as string), deep = hex(t.deep as string);
    const surfaces = [bg, panel, deep];
    const muted = readable(mix(fg, bg, 0.28), fg, surfaces);
    const faint = readable(mix(fg, bg, 0.36), fg, surfaces);
    const accent = readable(hex(t.accent as string), fg, surfaces, 0);
    const accentHover = mix(accent, fg, 0.18);
    const ink = ratio([0, 0, 0], accent) >= ratio([255, 255, 255], accent) ? "#000000" : "#ffffff";
    const line = hex(t.border as string);
    const s = root.style;
    const set = (k: string, v: string) => s.setProperty(k, v);
    const h = toHex;
    set("color-scheme", t.light ? "light" : "dark");
    set("--bg", h(bg)); set("--bg-deep", h(deep)); set("--panel", h(panel)); set("--panel-2", h(panel));
    set("--line", h(line)); set("--line-2", h(mix(bg, fg, 0.38)));
    set("--fg", h(fg)); set("--prose", h(fg)); set("--muted", h(muted)); set("--faint", h(faint));
    set("--accent", h(accent)); set("--hue-accent", h(accent)); set("--accent-hover", h(accentHover)); set("--accent-ink", ink);
    set("--comment", h(faint)); set("--ok", h(accent));
    set("--selection", (t.sel as string)); set("--hover", `color-mix(in srgb, ${h(fg)} 7%, transparent)`);
    set("--page-bg", h(bg));
    set("--header-bg", h(deep)); set("--header-bg-stuck", h(deep)); set("--header-bg-solid", h(deep));
    set("--code-bg", h(deep)); set("--well", h(deep));
    for (const k of ["--surface", "--surface-raised", "--raised", "--figure-bg", "--ticket-bg"]) set(k, h(panel));
    set("--control-bg", h(panel)); set("--control-bg-hover", h(mix(panel, fg, 0.07)));
    set("--pill-bg", h(panel));
    set("--bevel-border", h(mix(bg, fg, 0.22))); set("--edge", h(mix(bg, fg, 0.3)));
    set("--rail-active", h(mix(panel, accent, 0.14)));
    set("--nex-grad-text", `linear-gradient(105deg, ${h(accent)}, ${h(mix(accent, fg, 0.45))})`);
    const force = document.getElementById("theme-color-force");
    if (force) {
      force.removeAttribute("media");
      force.setAttribute("content", h(deep));
    }
  }
  function resetPage() {
    PAGE_VARS.forEach((k) => root.style.removeProperty(k));
    const force = document.getElementById("theme-color-force");
    if (force && root.getAttribute("data-theme-choice") === "system") force.setAttribute("media", "not all");
    else if (force) force.setAttribute("content", getComputedStyle(root).getPropertyValue("--theme-color").trim() || "#07080e");
  }

  // ---- preview state ----
  const pick = document.querySelector<HTMLSelectElement>("[data-pick]")!;
  const swatches = document.querySelector<HTMLElement>("[data-swatches]")!;
  const swatchBtns = [...swatches.querySelectorAll<HTMLButtonElement>("button")];
  const picker = document.querySelector<HTMLElement>("[data-picker]")!;
  const repaintBox = document.querySelector<HTMLInputElement>("[data-repaint]")!;
  const repaintWrap = document.querySelector<HTMLElement>("[data-repaint-wrap]")!;
  const chip = document.querySelector<HTMLElement>("[data-chip]")!;
  const tourBtn = document.querySelector<HTMLButtonElement>("[data-tour]")!;
  picker.hidden = swatches.hidden = repaintWrap.hidden = false;

  let current = pick.value;
  let chosen = false; // false until the visitor picks something: the page keeps the brand palette

  function apply(id: string) {
    const t = byId.get(id);
    if (!t) return;
    current = id;
    pick.value = id;
    document.querySelectorAll<HTMLElement>("[data-live-scope]").forEach((scope) => {
      for (const k of KEYS) scope.style.setProperty(`--p-${k}`, t[k] as string);
      const ed = scope.querySelector<HTMLElement>("[data-editor]");
      if (ed) {
        for (const k of KEYS) ed.style.setProperty(`--p-${k}`, t[k] as string);
        const set = (key: string, text: string) => {
          const el = ed.querySelector(`[data-ed=${key}]`);
          if (el) el.textContent = text;
        };
        set("name", t.name);
        set("kind", t.light ? "Light" : "Dark");
        set("family", t.family);
      }
      scope.querySelectorAll<HTMLElement>("[data-hex]").forEach((el) => (el.textContent = String(t[el.dataset.hex!]).toUpperCase()));
    });
    document.querySelectorAll("[data-theme-short]").forEach((el) => (el.textContent = t.short));
    document.querySelectorAll("[data-snippet-name]").forEach((el) => (el.textContent = t.name));
    const kind = document.querySelector("[data-theme-kind]");
    if (kind) kind.textContent = `${t.light ? "Light" : "Dark"} · ${t.family}`;
    const link = document.querySelector<HTMLAnchorElement>("[data-theme-link]");
    if (link) link.href = `/themes/${t.id}/`;
    swatchBtns.forEach((b) => {
      const on = b.dataset.id === id;
      b.setAttribute("aria-checked", String(on));
      b.tabIndex = on ? 0 : -1;
      if (on) {
        const left = b.offsetLeft - (swatches.clientWidth - b.offsetWidth) / 2;
        swatches.scrollTo({ left, behavior: reduceMotion ? "auto" : "smooth" });
      }
    });
    if (chosen && repaintBox.checked) {
      repaintPage(t);
      chip.hidden = false;
    }
  }

  /** A visitor's own choice: stops the tour, and shows the result if nothing else on screen will. */
  function choose(id: string, fromCard = false) {
    stopTour();
    chosen = true;
    apply(id);
    if (fromCard && !repaintBox.checked) document.getElementById("preview")?.scrollIntoView({ block: "center" });
  }

  pick.addEventListener("change", () => choose(pick.value));
  picker.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
    b.addEventListener("click", () => {
      const i = themes.findIndex((t) => t.id === current);
      const step = Number(b.dataset.step);
      const next = themes[(i + step + themes.length) % themes.length];
      choose(next.id);
    }),
  );
  swatchBtns.forEach((b, i) => {
    b.addEventListener("click", () => choose(b.dataset.id!));
    b.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const n = swatchBtns[(i + step + swatchBtns.length) % swatchBtns.length];
      choose(n.dataset.id!);
      n.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-try]").forEach((b) => b.addEventListener("click", () => choose(b.dataset.try!, true)));

  repaintBox.addEventListener("change", () => {
    if (repaintBox.checked) {
      chosen = true;
      repaintPage(byId.get(current)!);
      chip.hidden = false;
    } else {
      resetPage();
      chip.hidden = true;
    }
  });
  chip.querySelector("[data-reset]")!.addEventListener("click", () => {
    repaintBox.checked = false;
    resetPage();
    chip.hidden = true;
  });

  // ---- tour: steps through the themes; off for reduced motion, paused off screen ----
  let timer: number | undefined;
  let tourOn = false;
  let visible = true;
  const setTour = (on: boolean) => {
    tourOn = on;
    tourBtn.setAttribute("aria-pressed", String(on));
    tourBtn.querySelector("[data-tour-label]")!.textContent = on ? "on" : "off";
    window.clearInterval(timer);
    if (on) {
      timer = window.setInterval(() => {
        if (!visible || document.hidden) return;
        const i = themes.findIndex((t) => t.id === current);
        apply(themes[(i + 1) % themes.length].id);
      }, 4200);
    }
  };
  function stopTour() {
    if (tourOn) setTour(false);
  }
  tourBtn.addEventListener("click", () => {
    if (!tourOn) chosen = true;
    setTour(!tourOn);
  });
  new IntersectionObserver((es) => (visible = es[0].isIntersecting), { threshold: 0.1 }).observe(document.getElementById("preview")!);
  if (!reduceMotion) setTour(true);

  // ---- gallery filter, in the shape of a WHERE clause ----
  const input = document.getElementById("q") as HTMLInputElement;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
  const groups = [...document.querySelectorAll<HTMLElement>("[data-family]")];
  const countEl = document.querySelector("[data-count]")!;
  const emptyEl = document.querySelector<HTMLElement>("[data-empty]")!;
  const clearBtn = document.querySelector<HTMLButtonElement>("[data-clear]")!;
  const SHARED = new Set(["nexql", "dark", "light", "day", "night", "at", "of"]);
  const vocab = new Set<string>();
  cards.forEach((c) => c.dataset.words!.split(/[^a-z0-9]+/).filter((w) => w && !SHARED.has(w)).forEach((w) => vocab.add(w)));
  function filter() {
    const q = input.value.toLowerCase();
    const wantDark = /\b(dark|night)\b/.test(q);
    const wantLight = /\b(light|day)\b/.test(q);
    const asked = new Set(q.split(/[^a-z0-9]+/).filter((w) => vocab.has(w)));
    let n = 0;
    cards.forEach((c) => {
      const w = new Set(c.dataset.words!.split(/[^a-z0-9]+/));
      let show = true;
      if (wantDark && !wantLight) show = c.dataset.kind === "dark";
      if (wantLight && !wantDark) show = c.dataset.kind === "light";
      for (const a of asked) if (!w.has(a)) show = false;
      c.hidden = !show;
      if (show) n++;
    });
    groups.forEach((g) => (g.hidden = ![...g.querySelectorAll<HTMLElement>("[data-card]")].some((c) => !c.hidden)));
    countEl.textContent = String(n);
    emptyEl.hidden = n > 0;
    clearBtn.hidden = q === "";
  }
  input.addEventListener("input", filter);
  clearBtn.addEventListener("click", () => {
    input.value = "";
    filter();
    input.focus();
  });

  // ---- Route progress: rail on wide screens, bar on narrow ones ----
  const stops = [...document.querySelectorAll<HTMLElement>(".stop")];
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>(".rail a[data-stop]")];
  const railList = document.querySelector<HTMLElement>(".rail ol");
  const fill = document.querySelector<HTMLElement>(".track-fill");
  const mFill = document.querySelector<HTMLElement>(".mbar-fill");
  const mLabel = document.querySelector<HTMLElement>(".mbar-label");
  const pad = (n: number) => String(n).padStart(2, "0");
  function update() {
    const mark = window.innerHeight * 0.35;
    let active = 0;
    stops.forEach((s, i) => {
      if (s.getBoundingClientRect().top <= mark) active = i;
    });
    const r = stops[active].getBoundingClientRect();
    const within = Math.min(1, Math.max(0, (mark - r.top) / Math.max(1, r.height)));
    const progress = (active + within) / stops.length;
    railLinks.forEach((a, i) => {
      a.classList.toggle("active", i === active);
      a.classList.toggle("done", i < active);
      if (i === active) a.setAttribute("aria-current", "step");
      else a.removeAttribute("aria-current");
    });
    if (fill && railList && railLinks.length) {
      const first = railLinks[0].querySelector(".dot")!.getBoundingClientRect();
      const cur = railLinks[active].querySelector(".dot")!.getBoundingClientRect();
      const next = railLinks[Math.min(active + 1, railLinks.length - 1)].querySelector(".dot")!.getBoundingClientRect();
      fill.style.height = `${Math.max(0, cur.top - first.top + (next.top - cur.top) * within)}px`;
    }
    if (mFill) mFill.style.width = `${progress * 100}%`;
    if (mLabel) mLabel.textContent = `Stop ${pad(active + 1)} of ${pad(stops.length)} · ${railLinks[active]?.querySelector(".rail-label")?.textContent ?? ""}`;
  }
  if (railList) {
    const setH = () => railList.parentElement?.style.setProperty("--rail-h", `${railList.offsetHeight}px`);
    setH();
    window.addEventListener("resize", setH);
  }
  let queued = false;
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true },
  );
  window.addEventListener("resize", update);
  update();
</script>
